{
  "_comment": "Demo input with a DELIBERATE defect for scripts/workflow_validator.py: 'Blocked' is a status with no way out, so the validator reports it cannot reach a terminal state. Fix: model blocking as a flag, not a status (see sample_workflow.json for the clean version).",
  "name": "Software delivery workflow",
  "initial_state": "Backlog",
  "states": [
    "Backlog",
    "Ready",
    "In Progress",
    "In Review",
    "Blocked",
    "Done"
  ],
  "terminal_states": [
    "Done"
  ],
  "transitions": [
    {
      "name": "Refine",
      "from": "Backlog",
      "to": "Ready"
    },
    {
      "name": "Start work",
      "from": "Ready",
      "to": "In Progress"
    },
    {
      "name": "Request review",
      "from": "In Progress",
      "to": "In Review"
    },
    {
      "name": "Request changes",
      "from": "In Review",
      "to": "In Progress"
    },
    {
      "name": "Approve and complete",
      "from": "In Review",
      "to": "Done"
    },
    {
      "name": "Mark blocked",
      "from": "In Progress",
      "to": "Blocked"
    },
    {
      "name": "Reopen",
      "from": "Done",
      "to": "In Progress"
    }
  ]
}
